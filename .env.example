# ---- Server (Node process) ----
# Port the HTTP + WebSocket server listens on.
PORT=8787
# Where room snapshots are persisted when DATABASE_URL is not set (JSON files).
DATA_DIR=./data
# OPTIONAL: Postgres connection string (e.g. a free Supabase / Neon database).
# When set, rooms are persisted in Postgres instead of local files, so games survive
# restarts even on hosts with an ephemeral disk. NEVER commit real credentials.
DATABASE_URL=
# Comma separated list of allowed browser origins for the WebSocket (empty = allow all).
ALLOWED_ORIGINS=
# Seconds a dropped connection is tolerated before the player is shown as disconnected.
DISCONNECT_GRACE_SECONDS=6

# ---- Frontend (build time, Vite) ----
# Only needed when the frontend is hosted separately from the Node server
# (e.g. Cloudflare Pages + Render). Example: wss://card-rush-online.onrender.com/ws
VITE_WS_URL=
